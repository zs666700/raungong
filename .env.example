# ---- 应用 ----
TPA_ENV=dev
TPA_PORT=8000
TPA_DATA_DIR=./data

# ---- 安全 ----
TPA_JWT_SECRET=
TPA_JWT_EXPIRE_HOURS=12
TPA_ROOT_USERNAME=root
TPA_ROOT_PASSWORD=
TPA_ALLOW_REGISTER=true

# ---- 模型 ----
TPA_LLM_BASE_URL=https://api.deepseek.com
TPA_LLM_API_KEY=
TPA_LLM_MODEL=deepseek-chat
TPA_LLM_TEMPERATURE=0.3

# ---- 高德 ----
TPA_AMAP_KEY=
TPA_AMAP_TIMEOUT=8

# ---- RAG ----
TPA_RAG_ENABLED=true
# 向量化后端：api = 调 OpenAI 兼容的 /embeddings（默认，无需 torch）
#             local = 本地 sentence-transformers 跑 BAAI/bge-m3（需 torch + 约 2.3 GB）
TPA_RAG_EMBEDDING_PROVIDER=api
# 模型名（维度必须与 TPA_RAG_EMBEDDING_DIM 一致）
#   硅基流动  BAAI/bge-m3        -> 1024
#   阿里百炼  text-embedding-v3  -> 1024
TPA_RAG_EMBEDDING_MODEL=BAAI/bge-m3
# 接口地址（要带 /v1，代码里会拼 /embeddings）
#   硅基流动  https://api.siliconflow.cn/v1
#   阿里百炼  https://dashscope.aliyuncs.com/compatible-mode/v1
TPA_RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# ★ 向量化 API Key（api 模式必填；空着能启动，但知识库上传会 503）
TPA_RAG_EMBEDDING_API_KEY=
# 向量维度：换模型必须同步改，并清空 data/chroma
TPA_RAG_EMBEDDING_DIM=1024
TPA_RAG_CHUNK_SIZE=800
TPA_RAG_TOP_K=5

# ---- Agent ----
TPA_AGENT_MAX_ITERATIONS=8
